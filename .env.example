PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
HEARTBEAT_TIMEOUT_MS=30000
HEARTBEAT_CHECK_INTERVAL_MS=5000
REGISTRATION_TIMEOUT_MS=10000
WS_MAX_PAYLOAD_BYTES=16384
AGENT_WS_URL=ws://localhost:4000/agent
PUBLIC_BASE_URL=http://localhost:4000

# Generate a random value of at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
# Generate an Argon2id hash; never store the plaintext password here.
ADMIN_PASSWORD_HASH=replace-with-an-argon2id-password-hash
DEVICE_STORE_PATH=data/devices.json
TRUST_STORE_PATH=data/trusted-access.json

SESSION_APPROVAL_TIMEOUT_MS=60000
SESSION_NEGOTIATION_TIMEOUT_MS=45000
SESSION_DISCONNECT_TIMEOUT_MS=15000
# JSON. TURN credentials belong only in server environment configuration.
ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
